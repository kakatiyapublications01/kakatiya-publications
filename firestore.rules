rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    // Magazines Collection
    match /magazines/{magazineId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // VIP Collection
    match /vip/{vipId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // VVIP Collection
    match /vvip/{vvipId} {
      allow read: if isPublished() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Analytics Collection (Read-only for Admins)
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false; // Server API handles analytics writes
    }
  }
}
