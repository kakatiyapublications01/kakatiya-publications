rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "sanjay@kakatiyapublications.com" ||
        request.auth.token.email == "admin@kakatiyapulse.com"
      );
    }

    function isValidPdf() {
      return request.resource.contentType == 'application/pdf'
          && request.resource.size < 50 * 1024 * 1024; // 50MB Max
    }

    function isValidImage() {
      return (request.resource.contentType == 'image/jpeg'
           || request.resource.contentType == 'image/jpg'
           || request.resource.contentType == 'image/png'
           || request.resource.contentType == 'image/webp')
          && request.resource.size < 10 * 1024 * 1024; // 10MB Max
    }

    // Magazine PDFs & Cover Images
    match /magazines/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && (isValidPdf() || isValidImage());
      allow delete: if isAdmin();
    }

    // Posters & Images
    match /posters/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Announcements Images
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // General Uploads
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && (isValidImage() || isValidPdf());
      allow delete: if isAdmin();
    }
  }
}
